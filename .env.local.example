# 本地測試環境配置
# 複製此檔案為 .env.local 並填入實際的服務 URL

# 資料庫（PostgreSQL）
# 本地開發建議使用 Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres
# 或使用 Supabase 免費方案
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tour_dev"

# Resort API（雪場資訊服務）
# 本地開發: http://localhost:8001
# 生產環境: https://resort-api.zeabur.app
RESORT_API_URL=

# User Core API（用戶核心服務）
# 本地開發: http://localhost:8002
# 生產環境: https://user-core.zeabur.app
USER_CORE_API_URL=

# Snowbuddy Matching API（雪友配對服務）
# 本地開發: http://localhost:8003
# 生產環境: https://snowbuddy.zeabur.app
SNOWBUDDY_API_URL=

# 測試用戶 ID（用於本地測試）
TEST_USER_ID=test-user-001
